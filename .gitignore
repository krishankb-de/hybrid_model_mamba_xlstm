# .gitignore for hybrid-xmamba project

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter Notebook
.ipynb_checkpoints
# *.ipynb  # Allow tracking of important Colab setup notebooks
# !Colab_Setup.ipynb  # Keep setup notebook tracked

# PyTorch
*.pth
*.pt
*.ckpt

# Data
data/cache/
data/processed/
data/*.json
data/*.txt
*.hdf5
*.h5

# Outputs
outputs/
checkpoints/
logs/
wandb/
lightning_logs/

output_willi_server/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# OS
.DS_Store
Thumbs.db

# Hydra
.hydra/
multirun/

# Compiled CUDA
*.o
*.cu.o

# Documentation
*.md   

# Allow specific markdown files
!PHASE_PLAN.md
!STAGE1_RECOVERY_PLAN.md




# Multi-phase plan local state (regenerated from PHASE_PLAN.md checkboxes)
phase_state.json
stage1_recovery_state.json